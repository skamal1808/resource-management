{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compliance Tracker",
  "version": "2.0.0",
  "identifier": "in.vmgassociates.compliancetracker",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Team Resource & Compliance Tracker — VMG & Associates",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "../web/icons/icon-512.png"
    ]
  }
}
